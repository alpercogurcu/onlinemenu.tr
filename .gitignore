# Binaries
bin/
dist/
tmp/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Build output (go build ./cmd/api gibi kök dizine çıkan binary'ler)
/api
/edge
/worker
/migrate

# Test & coverage
*.test
*.out
coverage.html
coverage.out

# Go workspace (local overrides)
go.work
go.work.sum

# Secrets — asla commit edilmez
.env
.env.local
.env.*.local
*.pem
*.key

# deploy/.env.prod — docker-compose.prod.yml kurulum sırasının 1. adımında
# .env.prod.example'dan kopyalanıp GERÇEK sırlarla doldurulan düz metin dosya.
# Yukarıdaki ".env" kalıbı bunu YAKALAMAZ (tam ad eşleşmesi), o yüzden ayrıca
# yazıldı. Şablon (.env.prod.example) ve şifreli hâl (.env.prod.sops) hariç.
.env.prod
!.env.prod.example
!.env.prod.sops

# SOPS şifreli dosyalar commit edilir; düz metin asla
# .env.sops → commit edilir (şifreli)
# .env      → commit edilmez (bu satır üstte)

# Air hot-reload
tmp/

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Node / pnpm
node_modules/
web/node_modules/
web/apps/*/node_modules/
web/packages/*/node_modules/
.pnpm-store/

# Next.js — app adı başına tek tek değil, apps/* kalıbıyla: yeni bir Next
# uygulaması (web/apps/menu, ARCH-006 WP4) eklendiğinde build çıktısı
# .gitignore güncellenmezse sessizce commit'e girmeye aday oluyordu.
web/apps/*/.next/
web/apps/*/out/
web/apps/*/next-env.d.ts

# Wails build output
web/apps/pos-desktop/build/bin/

# Ko build cache
.ko/

# testcontainers ryuk
.testcontainers.properties
.superpowers/

# TypeScript build cache
*.tsbuildinfo

# Playwright MCP
.playwright-mcp/

# Test screenshots (root dizininde oluşturulanlar)
/*.png
/*.jpg
