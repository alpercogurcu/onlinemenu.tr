# =============================================================================
# Online Menu — PROD ortam değişkenleri ŞABLONU
#
# docker-compose.prod.yml başlığındaki kurulum sırasının 1. adımı bu dosyadır:
#
#   cp deploy/.env.prod.example deploy/.env.prod    # gerçek değerleri doldur
#   sops -e deploy/.env.prod > deploy/.env.prod.sops   # bu ŞİFRELİ hâli commit edilir
#   rm deploy/.env.prod                                # düz metin hâli SİLİNİR
#
# Deploy anında:
#   sops -d deploy/.env.prod.sops > deploy/.env
#   docker compose -f deploy/docker-compose.prod.yml up -d
#
# ⚠️ Bu dosya (.example) ŞABLONDUR ve GERÇEK DEĞER İÇERMEZ. Aşağıdaki
# yer tutucuların hiçbiri kullanılabilir bir sır değildir; hepsi
# değiştirilmelidir.
#
# ⚠️ deploy/.env ve deploy/.env.prod ASLA commit edilmez (CLAUDE.md: ".env düz
# metin dosyası repo'ya asla commit edilmez").
#
# ⚠️ Vault unseal anahtarları ve root token BU DOSYAYA YAZILMAZ. Onlar Vault'u
# açmak için kullanılır, Vault'ta veya Vault'a bağımlı bir yerde saklanamazlar
# — ayrı, çevrimdışı bir parola kasası gerekir (compose'daki vault notu).
# =============================================================================

# --- Postgres ----------------------------------------------------------------
# Üçü de deploy/postgres/init.prod.sh tarafından İLK açılışta okunur. Sonradan
# değiştirmek rolleri güncellemez: volume zaten init edilmiş olur.
POSTGRES_DB=onlinemenu
POSTGRES_SUPERUSER_PASSWORD=DEGISTIR_openssl_rand_base64_32
APP_MIGRATOR_PASSWORD=DEGISTIR_openssl_rand_base64_32
APP_RUNTIME_PASSWORD=DEGISTIR_openssl_rand_base64_32

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=DEGISTIR_openssl_rand_base64_32

# --- Keycloak ----------------------------------------------------------------
# KEYCLOAK_HOSTNAME gerçek genel domain olmalı (realm sslRequired="external"
# olduğu için localhost dışında HTTPS zorunlu). TLS'i önündeki ters proxy verir.
KEYCLOAK_HOSTNAME=auth.example.com
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=DEGISTIR
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=DEGISTIR_openssl_rand_base64_32

# ZORUNLU (üretimde fiilen): boş bırakılırsa Keycloak açılır ama parola
# belirleme e-postası gönderilemez — her davet elle parola belirlemeyi
# gerektirir (bkz. deploy/keycloak/README.md §5). realm-onlinemenu.json'daki
# smtpServer bloğu bu değişkenleri "${SMTP_HOST}" gibi Keycloak'ın kendi
# realm-import placeholder'larıyla okur (${env.X} DEĞİL — Keycloak öyle bir
# söz dizimini tanımıyor).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@example.com
SMTP_USER=DEGISTIR
SMTP_PASSWORD=DEGISTIR
SMTP_STARTTLS=true

# --- MinIO -------------------------------------------------------------------
# Uygulama kodu MinIO'yu henüz KULLANMIYOR (storage.go yalnızca arayüz).
MINIO_ROOT_USER=DEGISTIR
MINIO_ROOT_PASSWORD=DEGISTIR_openssl_rand_base64_32

# --- Vault -------------------------------------------------------------------
# `vault operator init` + unseal SONRASI üretilen, uygun policy'li bir token.
# ROOT TOKEN KULLANMAYIN.
VAULT_TOKEN=DEGISTIR_vault_token

# --- api ---------------------------------------------------------------------
# ko ile üretilip registry'ye push'lanan pinli imaj. "latest" yasak.
API_IMAGE=registry.example.com/onlinemenu/api:v0.1.0
API_IMAGE_TAG=v0.1.0

# Personel context token imza anahtarı.
#   openssl rand -hex 32
CTX_TOKEN_SECRET=DEGISTIR_openssl_rand_hex_32

# Storefront misafir oturum imza anahtarı (ADR-ARCH-006 §5).
# ⚠️ CTX_TOKEN_SECRET ile AYNI DEĞER OLMAMALI: bu anahtar auth'suz, herkese
# açık QR yüzeyine hizmet eder; personel token'larıyla anahtar paylaşmak bir
# storefront sızıntısını personel yetkisi sızıntısına çevirir.
# ⚠️ En az 32 bayt: aşağıdaki komut 64 karakterlik hex (=32 bayt) üretir.
#   openssl rand -hex 32
# api servisi bu değer boşsa AÇILMAZ (cmd/api/main.go newGuestTokenSigner).
STOREFRONT_GUEST_TOKEN_SECRET=DEGISTIR_openssl_rand_hex_32

# POS WebSocket'i için izinli origin listesi. Admin paneli ters proxy'de aynı
# origin altındaysa boş bırakmak güvenli varsayılan.
POS_WS_ALLOWED_ORIGINS=

# --- Token/Beko X30TR ÖKC (ADR-FISCAL-001) -----------------------------------
# fiscal_device_type üretimde sabit (beko_x30tr_cloud); bunlar olmadan mali
# kayıt yapılamaz.
TOKENX_API_URL=https://DEGISTIR
TOKENX_AUTH_URL=https://DEGISTIR
TOKENX_CLIENT_ID=DEGISTIR
TOKENX_CLIENT_SECRET=DEGISTIR
TOKENX_BASKET_MODE=instant
TOKENX_DEFAULT_TERMINAL=
# Boş bırakılamaz: webhook ucu boşken sessizce devre dışı kalıyor.
TOKENX_WEBHOOK_SECRET=DEGISTIR_openssl_rand_hex_32

# --- Web uygulamaları (menu / admin) -----------------------------------------
# ⚠️ MENU_PUBLIC_URL admin imajına DERLEME ANINDA gömülür (NEXT_PUBLIC_MENU_URL)
# ve BASILAN QR KODLARININ tabanıdır. Sonradan değiştirmek, önceden basılmış
# QR'ları geçersiz kılar; değiştirirseniz admin imajı YENİDEN derlenmelidir:
#   docker compose -f deploy/docker-compose.prod.yml build admin
MENU_PUBLIC_URL=https://menu.example.com

# Bu iki değişken opsiyoneldir. Boş bırakılırsa imajlar bu compose tarafından
# kaynaktan derlenir ve onlinemenu/{menu,admin}:local olarak etiketlenir.
# Bir registry'ye push'layıp pinli çekmek isterseniz doldurun.
#MENU_IMAGE=registry.example.com/onlinemenu/menu:v0.1.0
#ADMIN_IMAGE=registry.example.com/onlinemenu/admin:v0.1.0

# --- Yedekleme (ADR-OPS-001) -------------------------------------------------
BACKUP_RETENTION_DAYS=14
# 21600 sn = 6 saat. Bu değer aynı zamanda RPO üst sınırıdır.
BACKUP_INTERVAL_SECONDS=21600
# Boş bırakılırsa yalnızca yerel (volume içi) yedek alınır — tek host
# kaybında yedek de kaybolur. Herhangi bir S3-uyumlu hedef doldurulabilir.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# --- Observability (yalnızca --profile observability ile) --------------------
GRAFANA_ADMIN_USER=DEGISTIR
GRAFANA_ADMIN_PASSWORD=DEGISTIR_openssl_rand_base64_32
